@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.11.3 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/logAnalyzerTargets.cmake")

# Public headers expose nlohmann::json in API signatures.
if(TARGET logAnalyzer::LogAnalyzerLib)
    target_link_libraries(logAnalyzer::LogAnalyzerLib INTERFACE nlohmann_json::nlohmann_json)
endif()
